# Base de datos
DB_HOST=TU_HOST
DB_PORT=TU_PUERTO
DB_USER=TU_USUARIO
DB_PASS=TU_PASSWORD
DB_NAME=TU_BASE_DE_DATOS

# JWT
JWT_SECRET=TU_SECRETO_JWT

# Entorno (dev, prod)
ENV=TU_ENTORNO

# Mercado Libre
ML_CLIENT_ID=TU_CLIENT_ID
ML_CLIENT_SECRET=TU_CLIENT_SECRET

# Servicio de scraping del RCV (llamativoAdminRcvScrapp)
# El backend no lo llama: solo recibe los registros en POST /purchases/import
# El scraping se dispara desde el propio servicio (GET /rcv/sincronizar)

# WooCommerce
WOO_BASE_URL=TU_URL_TIENDA
WOO_CONSUMER_KEY=TU_CONSUMER_KEY
WOO_CONSUMER_SECRET=TU_CONSUMER_SECRET

# Google Drive (Service Account)
GOOGLE_DRIVE_CLIENT_EMAIL=TU_CLIENT_EMAIL@TU_PROJECT.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA\n-----END PRIVATE KEY-----"
GOOGLE_DRIVE_FOLDER_ID=TU_FOLDER_ID

# (Opcional) Puerto de la app (default: 3000)
PORT=TU_PUERTO
